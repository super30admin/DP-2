class Solution {
    /**
     * Time complexity:o(3n)=> o(n)
       Space complexity: o(3n)=> o(n)
     */
    public int minCost(int[][] costs) {
        //Given n houses and 3 color choices for each house.
        int rows = costs.length; // number of houses
        int cols = costs[0].length;// cols are 3 
        int dp[][] = new int[rows][cols];

        //start with last house that is rows-1
        for (int col = 0; col < cols; col++) {
            dp[rows - 1][col] = costs[rows - 1][col];

        }
        
        for (int row = rows - 2; row >= 0; row--) {
            dp[row][0] = costs[row][0] + Math.min(dp[row + 1][1], dp[row + 1][2]);
            dp[row][1] = costs[row][1] + Math.min(dp[row + 1][0], dp[row + 1][2]);
            dp[row][2] = costs[row][2] + Math.min(dp[row + 1][0], dp[row + 1][1]);

        }
        return Math.min(dp[0][0], Math.min(dp[0][1], dp[0][2]));

    }
}